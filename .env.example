# ==============================================================================
# InfraPulse - Unified Root Environment Configuration Template
# ==============================================================================

# Application Ports
FRONTEND_PORT=8080
BACKEND_PORT=5000

# PostgreSQL Configuration
POSTGRES_DB=infrapulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
PGPORT=5432

# Application Settings
NODE_ENV=production
FRONTEND_URL=http://localhost:8080
APP_BASE_URL=http://localhost:8080

# Notifications
NOTIFICATION_MOCK_MODE=true
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@infrapulse.io
SMTP_PASS=your_smtp_password
SMTP_FROM="InfraPulse Alerts <alerts@infrapulse.io>"

# Enterprise Integrations & Platform Ecosystem (Phase 19)
# 32-byte secret key for authenticated AES-256-GCM envelope encryption at rest
INTEGRATION_ENCRYPTION_KEY=replace_with_secure_random_32_byte_hex_or_string_key
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_sha256_secret
KUBERNETES_API_URL=https://kubernetes.default.svc
KUBERNETES_BEARER_TOKEN=your_k8s_service_account_readonly_token
PROMETHEUS_ENDPOINT=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_SERVICE_TOKEN=your_grafana_service_account_token
OTEL_INGESTION_KEY=your_otlp_http_ingestion_api_key


# Cloud Lifecycle & Cost Governance (Phase 23C - 23F)
AWS_ALLOWED_REGIONS=ap-south-1,us-east-1,us-west-2
AWS_REGION=ap-south-1
AWS_LIFECYCLE_MUTATIONS_ENABLED=false
AWS_ALLOWED_INSTANCE_IDS=
DOCKER_LIFECYCLE_ENABLED=false
DOCKER_ALLOWED_CONTAINERS=
KUBERNETES_LIFECYCLE_ENABLED=false
KUBERNETES_ALLOWED_WORKLOADS=

# Governed Automated Remediation Intelligence (Phase 23J)
REMEDIATION_RECOMMENDATIONS_ENABLED=true
REMEDIATION_DRY_RUN_ENABLED=true
REMEDIATION_EXECUTION_ENABLED=false
REMEDIATION_PRODUCTION_ENABLED=false
REMEDIATION_APPROVAL_TTL_MINUTES=60

# Autonomous SRE Intelligence (Phase 23K - 23L)
SRE_HEALTH_EVALUATION_INTERVAL_SECONDS=60
SRE_TELEMETRY_STALE_THRESHOLD_SECONDS=300
SRE_FORECAST_HORIZON_HOURS=48
