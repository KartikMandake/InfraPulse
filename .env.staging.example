# ==============================================================================
# InfraPulse - Staging Environment Configuration Template (.env.staging)
# Usage: Copy to .env.staging and customize with your staging cluster credentials.
# NEVER commit the active .env.staging file to version control.
# ==============================================================================

# Core Ports
FRONTEND_PORT=8080
BACKEND_PORT=5000
PGPORT=5432

# Runtime Mode
NODE_ENV=production

# URLs & CORS
FRONTEND_URL=https://staging.infrapulse.internal
APP_BASE_URL=https://staging.infrapulse.internal
CORS_ORIGIN=https://staging.infrapulse.internal,http://localhost:8080
TRUST_PROXY=1
REQUEST_BODY_LIMIT=2mb
COOKIE_SECURE=false

# Automatic Migrations & Safe Seeding
AUTO_MIGRATE=true
AUTO_SEED=true

# PostgreSQL Storage
POSTGRES_DB=infrapulse_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_staging_postgres_password

# Notifications & Mock Simulation
# Set NOTIFICATION_MOCK_MODE=true for staging so real customers are not alerted
NOTIFICATION_MOCK_MODE=true
SLACK_WEBHOOK_URL=YOUR_STAGING_SLACK_WEBHOOK_URL
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=staging_user
SMTP_PASS=staging_password
SMTP_FROM="InfraPulse Staging Alerts <staging-alerts@infrapulse.internal>"

# Enterprise Integrations & Encryption (Phase 19)
# Generate a dedicated random 32-character staging encryption key:
INTEGRATION_ENCRYPTION_KEY=replace_with_staging_aes256_secret_key_32bytes!
GITHUB_WEBHOOK_SECRET=replace_with_staging_github_webhook_hmac_secret
KUBERNETES_API_URL=https://staging-k8s.internal
KUBERNETES_BEARER_TOKEN=staging_service_account_token_placeholder
PROMETHEUS_ENDPOINT=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
GRAFANA_SERVICE_TOKEN=staging_grafana_service_token_placeholder
OTEL_INGESTION_KEY=staging_otlp_api_key_placeholder

