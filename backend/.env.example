# ==============================================================================
# InfraPulse Backend - Environment Configuration Template
# Copy to .env and customize. NEVER commit actual production secrets.
# ==============================================================================

# Core Runtime
NODE_ENV=development # 'development' | 'production' | 'test'
PORT=5000
LOG_LEVEL=info # 'debug' | 'info' | 'warn' | 'error'

# CORS & Client Base URLs
# In production, must be the HTTPS domain of your web interface (e.g. https://infrapulse.company.com)
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Telemetry Source Mode
TELEMETRY_MODE=demo # 'demo' (mock synthetic mesh) | 'live' (OTel collector)

# Local Observability Stack URLs (Default Docker Compose bindings)
PROMETHEUS_URL=http://localhost:9090
TEMPO_URL=http://localhost:3200
LOKI_URL=http://localhost:3100
OTEL_COLLECTOR_URL=http://localhost:4318

# Demo Services Endpoints
DEMO_GATEWAY_URL=http://localhost:4001
DEMO_ORDERS_URL=http://localhost:4002
DEMO_PAYMENTS_URL=http://localhost:4003

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5434
PGDATABASE=infrapulse
PGDATABASE_TEST=infrapulse_test
PGUSER=postgres
PGPASSWORD=your_secure_db_password_here
PGMAX=20
# Optional single connection URI:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5434/infrapulse

# Notification Delivery Configuration (Phase 9)
# In development / test, set NOTIFICATION_MOCK_MODE=true to simulate delivery without outbound HTTP/SMTP calls
NOTIFICATION_MOCK_MODE=true
NOTIFICATION_WORKER_ENABLED=true # Set to false if running dedicated worker container

# Slack Incoming Webhook (HTTPS only; restricted to hooks.slack.com)
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL

# SMTP Relay Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@infrapulse.io
SMTP_PASS=your_smtp_secret_password_here
SMTP_FROM="InfraPulse Alerts <alerts@infrapulse.io>"
