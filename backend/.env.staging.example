# ==============================================================================
# InfraPulse Backend - Staging Environment Configuration Template
# Copy to backend/.env.staging and customize for staging deployments.
# ==============================================================================

NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# In staging behind reverse proxy / ingress
FRONTEND_URL=https://staging.infrapulse.internal
APP_BASE_URL=https://staging.infrapulse.internal
CORS_ORIGIN=https://staging.infrapulse.internal,http://localhost:8080
TRUST_PROXY=1
REQUEST_BODY_LIMIT=2mb
COOKIE_SECURE=false

# Telemetry Source Mode
TELEMETRY_MODE=demo

# Internal Docker / K8s Observability DNS
PROMETHEUS_URL=http://prometheus:9090
TEMPO_URL=http://tempo:3200
LOKI_URL=http://loki:3100
OTEL_COLLECTOR_URL=http://otel-collector:4318

# Demo Synthetic Services (if deployed)
DEMO_GATEWAY_URL=http://demo-gateway:4001
DEMO_ORDERS_URL=http://demo-orders:4002
DEMO_PAYMENTS_URL=http://demo-payments:4003

# PostgreSQL Database Configuration
PGHOST=postgres
PGPORT=5432
PGDATABASE=infrapulse_staging
PGUSER=postgres
PGPASSWORD=replace_with_secure_staging_postgres_password
PGMAX=20

# Notification Delivery
NOTIFICATION_MOCK_MODE=true
NOTIFICATION_WORKER_ENABLED=false # Dedicated worker container handles queue
SLACK_WEBHOOK_URL=YOUR_STAGING_SLACK_WEBHOOK_URL
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=staging_user
SMTP_PASS=staging_password
SMTP_FROM="InfraPulse Staging Alerts <staging-alerts@infrapulse.internal>"

# Integration Encryption
INTEGRATION_ENCRYPTION_KEY=replace_with_staging_aes256_secret_key_32bytes!

