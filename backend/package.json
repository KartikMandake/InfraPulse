{
  "name": "infrapulse-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/entrypoint.js server",
    "start:worker": "node src/entrypoint.js worker",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "test": "node --test --test-concurrency=1 src/engine/__tests__/*.test.js src/services/__tests__/*.test.js src/integrations/telemetry/__tests__/*.test.js src/db/__tests__/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1161.0",
    "@aws-sdk/client-rds": "^3.1161.0",
    "@aws-sdk/client-sts": "^3.1161.0",
    "@aws-sdk/credential-providers": "^3.1161.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@prometheus-io/client": "0.16.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  }
}
