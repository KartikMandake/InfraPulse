  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "PostgreSQL Connection Pooling & Query Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "infrapulse_database_pool_connections{state=\"active\"}",
          "legendFormat": "Active Connections",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "infrapulse_database_pool_connections{state=\"idle\"}",
          "legendFormat": "Idle Connections",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "infrapulse_database_pool_connections{state=\"waiting\"}",
          "legendFormat": "Waiting Requests",
          "refId": "C"
        }
      ],
      "title": "Connection Pool Saturation",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(infrapulse_operations_total{operation=~\"db\\\\..*\"}[1m])) by (operation, outcome)",
          "legendFormat": "{{operation}} ({{outcome}})",
          "refId": "A"
        }
      ],
      "title": "Database Query & Transaction Rates",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(infrapulse_operation_duration_seconds_bucket{operation=\"db.query\"}[5m])) by (le))",
          "legendFormat": "P95 Query Duration",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(infrapulse_operation_duration_seconds_bucket{operation=\"db.transaction\"}[5m])) by (le))",
          "legendFormat": "P95 Transaction Duration",
          "refId": "B"
        }
      ],
      "title": "Database Operation Latency (P95)",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["infrapulse", "self-monitoring", "database", "postgres"],
  "time": { "from": "now-1h", "to": "now" },
