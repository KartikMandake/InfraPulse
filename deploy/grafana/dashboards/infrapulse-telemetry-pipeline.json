        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(infrapulse_operations_total{operation=\"telemetry.ingest\"}[1m])) by (outcome)",
          "legendFormat": "Ingestion ({{outcome}})",
          "refId": "A"
        }
      ],
      "title": "Telemetry Ingestion Rate (OTLP & Agent)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(infrapulse_operation_duration_seconds_bucket{operation=\"telemetry.ingest\"}[5m])) by (le))",
          "legendFormat": "P95 Ingestion Latency",
          "refId": "A"
        }
      ],
      "title": "Telemetry Processing Latency (P95)",
      "type": "timeseries"
    },
